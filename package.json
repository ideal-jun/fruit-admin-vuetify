{
  "name": "fruit-admin-veutify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "type-coverage": "type-coverage --project tsconfig.app.json --ignore-files '**/*.vue' --at-least 99",
    "type-coverage:detail": "type-coverage --project tsconfig.app.json --ignore-files '**/*.vue' --detail",
    "lint": "run-p lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "run-s lint:fix fmt",
    "check": "run-p type-check type-coverage lint fmt:check"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mdi/font": "7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@unocss/preset-wind4": "^66.12.0",
    "@unocss/transformer-directives": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "@vuetify/mcp": "^0.5.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-oxlint": "^1.90.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "sass-embedded": "^1.98.0",
    "type-coverage": "^2.31.1",
    "typescript": "~5.9.3",
    "unocss": "^66.12.0",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5"
  }
}
