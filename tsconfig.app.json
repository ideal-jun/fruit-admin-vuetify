{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue", "uno.config.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // Stricter than the `@vue/tsconfig` baseline: catch unsafe index access,
    // implicitly-overriding members, unused locals/params and switch fallthrough.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      // Type-only override that re-types Vuetify's `useLocale().t` with our message keys.
      // Vite does not read tsconfig paths, so the runtime import stays the real package.
      "vuetify": ["./src/typings/vuetify.d.ts"]
    }
  }
}
